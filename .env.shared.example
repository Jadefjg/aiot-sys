# 阿里云 ECS 共享中间件模板（复制键到已有 .env，不要整文件覆盖）
#
# 用法：
#   ./scripts/ensure-env.sh shared
# 或手动把下列键写入服务器 /opt/aiot-sys/.env（保留原有密码）
#
# git 不跟踪 .env：本地是 localhost:8080，服务器是公网 IP 与共享 MySQL，
# git pull 永远不会改 .env，这是预期行为。

COMPOSE_PROFILES=shared
HTTP_PORT=8082

# 容器内连公共中间件（不是宿主机映射端口 13306/16379）
MYSQL_HOST=shared-mysql
MYSQL_CONNECT_PORT=3306
REDIS_HOST=shared-redis
REDIS_CONNECT_PORT=6379
MQTT_BROKER_HOST=mqtt_lite
CELERY_BROKER_URL=redis://shared-redis:6379/1
CELERY_RESULT_BACKEND=redis://shared-redis:6379/1

MYSQL_DATABASE=iot_db
MYSQL_USER=iot_user
# MYSQL_PASSWORD / MYSQL_ROOT_PASSWORD / SECRET_KEY 使用服务器已有值，勿提交

ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://39.108.180.245:8082,http://39.108.180.245,http://127.0.0.1:8082
FIRMWARE_BASE_URL=http://39.108.180.245:8082/firmware_files
PROJECT_NAME=IoT System

INFLUX_ENABLED=false
INFLUX_URL=
INFLUX_ORG=iot
INFLUX_BUCKET=telemetry

SHARED_NETWORK=shared-infra
SHARED_EXTERNAL=true
MOSQUITTO_CONF=/opt/shared-infra/mosquitto/mosquitto.conf
