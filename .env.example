# 复制为 .env 后按需修改（仓库根目录）
#
# COMPOSE_PROFILES:
#   local  — 本地全栈（自带 MySQL / Redis / EMQX / InfluxDB）
#   shared — 阿里云共享中间件（外部 MySQL/Redis + Mosquitto，不启 InfluxDB）
COMPOSE_PROFILES=local
HTTP_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379
MYSQL_HOST=mysql_db
REDIS_HOST=redis_cache
MQTT_BROKER_HOST=mqtt_broker

MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=iot_db
MYSQL_USER=iot_user
MYSQL_PASSWORD=password

SECRET_KEY=please-change-this-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost,http://localhost:8080,http://127.0.0.1,http://127.0.0.1:8080

MQTT_USERNAME=
MQTT_PASSWORD=
FIRMWARE_BASE_URL=http://localhost:8080/firmware_files
MEDIA_BASE_URL=http://localhost:8080/media_files
MEDIA_AI_ENABLED=true
PROJECT_NAME=IoT System

INFLUX_PORT=8086
INFLUX_ENABLED=true
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=iot-influx-dev-token
INFLUX_ORG=iot
INFLUX_BUCKET=telemetry
INFLUX_USER=admin
INFLUX_PASSWORD=admin12345

# ----- 阿里云 shared 模式请改为（并设置 COMPOSE_PROFILES=shared）-----
# MYSQL_HOST=shared-mysql
# REDIS_HOST=shared-redis
# MQTT_BROKER_HOST=mqtt_lite
# CELERY_BROKER_URL=redis://shared-redis:6379/1
# CELERY_RESULT_BACKEND=redis://shared-redis:6379/1
# INFLUX_ENABLED=false
# INFLUX_URL=
# SHARED_NETWORK=shared-infra
# SHARED_EXTERNAL=true

