# 阿里云 ECS 全栈 Docker 模板（COMPOSE_PROFILES=local，自带 MySQL/Redis/EMQX）
#
# 用法（保留服务器已有密码，只补全缺失键）:
#   ./scripts/ensure-env.sh production
#
# 说明：.env 不在 git 中，git pull 不会改 .env；本地 localhost 与服务器公网 IP 不一致是预期行为。

COMPOSE_PROFILES=local
HTTP_PORT=8082
MYSQL_PORT=13306
REDIS_PORT=16379

MYSQL_HOST=mysql_db
REDIS_HOST=redis_cache
MQTT_BROKER_HOST=mqtt_broker

MYSQL_ROOT_PASSWORD=请改为强密码
MYSQL_DATABASE=iot_db
MYSQL_USER=iot_user
MYSQL_PASSWORD=请改为强密码

SECRET_KEY=请改为随机长字符串
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://<ECS公网IP>:8082,http://<ECS公网IP>:8088,http://<ECS公网IP>,http://127.0.0.1:8082
FIRMWARE_BASE_URL=http://<ECS公网IP>:8082/firmware_files
PROJECT_NAME=IoT System

MQTT_USERNAME=
MQTT_PASSWORD=

INFLUX_PORT=8086
INFLUX_ENABLED=true
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=请改为随机token
INFLUX_ORG=iot
INFLUX_BUCKET=telemetry
INFLUX_USER=admin
INFLUX_PASSWORD=请改为强密码
